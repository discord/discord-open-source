{
  "name": "discord-open-source",
  "version": "1.0.0",
  "main": "communities.json",
  "scripts": {
    "test": "npm run fmt-check && npm run validate-codes && npm run unit-test",
    "validate-codes": "node ./validate.js",
    "validate-online": "node ./validate.js --online",
    "unit-test": "node --test",
    "fmt-check": "prettier --check communities.json validate.js test/*.js",
    "fmt": "prettier --write communities.json validate.js test/*.js"
  },
  "devDependencies": { "prettier": "^3.6.2" }
}
